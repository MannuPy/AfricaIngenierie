# Variables de référence pour Render.
# Ne pas envoyer ce fichier comme secret : saisir les valeurs privées dans
# Render Dashboard ou via les invites du Blueprint.

NODE_ENV=production
PUBLIC_DOMAIN=africa-ingenierie-web.onrender.com
ADMIN_DOMAIN=africa-ingenierie-cms.onrender.com
NEXT_PUBLIC_SITE_URL=https://africa-ingenierie-web.onrender.com
PAYLOAD_PUBLIC_SERVER_URL=https://africa-ingenierie-cms.onrender.com

# Render injecte DATABASE_URL depuis le service PostgreSQL.
DATABASE_URL=postgresql://fourni-par-render
# Render injecte CMS_INTERNAL_HOSTPORT depuis le service CMS.
CMS_INTERNAL_HOSTPORT=africa-ingenierie-cms:10000

# Générés par Render dans le groupe partagé.
PAYLOAD_SECRET=generer-dans-render
PREVIEW_SECRET=generer-dans-render
REVALIDATION_SECRET=generer-dans-render
CONTACT_HASH_SECRET=generer-dans-render
CONTACT_INTERNAL_SECRET=generer-dans-render
CMS_INTERNAL_READ_SECRET=generer-dans-render

# Stockage objet S3-compatible durable (Cloudflare R2, AWS S3, etc.).
# Le code Payload conserve le préfixe MINIO_* pour rester compatible avec MinIO.
MINIO_ENDPOINT=compte.r2.cloudflarestorage.com
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_REGION=auto
MINIO_BUCKET=africa-media
MINIO_ACCESS_KEY=cle-r2
MINIO_SECRET_KEY=secret-r2

SMTP_HOST=smtp.fournisseur.example
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=compte-smtp
SMTP_PASSWORD=secret-smtp
SMTP_FROM_NAME=Africa Ingenierie
SMTP_FROM_ADDRESS=no-reply@africaingenieries.com
CONTACT_TO=contact@africaingenieries.com

AUTH_COOKIE_DOMAIN=africa-ingenierie-cms.onrender.com
CONTACT_RETENTION_MONTHS=24
BOOTSTRAP_USERS_ENABLED=false
BOOTSTRAP_USERS_ENV=production

# Utilisés uniquement par le Cron Render et à conserver dans un bucket
# distinct du bucket média.
MEDIA_ENDPOINT=https://compte.r2.cloudflarestorage.com
MEDIA_ACCESS_KEY=cle-r2-lecture
MEDIA_SECRET_KEY=secret-r2-lecture
MEDIA_BUCKET=africa-media
BACKUP_S3_ENDPOINT=https://compte-r2-backups.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=africa-backups
BACKUP_S3_ACCESS_KEY=cle-r2-backups
BACKUP_S3_SECRET_KEY=secret-r2-backups
BACKUP_ENCRYPTION_KEY=cle-secrete-de-chiffrement-de-32-caracteres-minimum
