# Payload et Next.js exigent des peer dependencies hissées correctement.
auto-install-peers=true
strict-peer-dependencies=false
# Le store pnpm n'est jamais écrit dans le dépôt. Dans les conteneurs, il est
# placé dans un volume nommé via la variable `npm_config_store_dir`
# (voir docker-compose.yml) - `PNPM_STORE_DIR` n'est PAS une option reconnue
# par pnpm. Hors conteneur, pnpm utilise son emplacement par défaut.
