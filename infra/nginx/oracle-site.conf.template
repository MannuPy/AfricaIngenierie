server {
  listen 80;
  server_name ${PUBLIC_DOMAIN} ${ADMIN_DOMAIN};
  location = /nginx-health { access_log off; default_type text/plain; return 200 "nginx ok\n"; }
  location ^~ /.well-known/acme-challenge/ { root /var/www/certbot; default_type text/plain; }
  location / { return 301 https://$host$request_uri; }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${PUBLIC_DOMAIN};
  ssl_certificate /etc/letsencrypt/live/${PUBLIC_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${PUBLIC_DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:10m;
  include /etc/nginx/oracle-security-headers.conf;

  location = /nginx-health { access_log off; default_type text/plain; return 200 "nginx ok\n"; }
  location ^~ /.well-known/acme-challenge/ { root /var/www/certbot; default_type text/plain; }
  location ^~ /_next/static/ {
    include /etc/nginx/oracle-proxy.conf;
    proxy_pass http://web:3000;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
  }
  location = /api/contact {
    limit_req zone=contact_zone burst=3 nodelay;
    limit_req_status 429;
    client_max_body_size 32k;
    include /etc/nginx/oracle-proxy.conf;
    proxy_pass http://web:3000;
  }
  location ^~ /admin { return 301 https://${ADMIN_DOMAIN}$request_uri; }
  location / { include /etc/nginx/oracle-proxy.conf; proxy_pass http://web:3000; }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${ADMIN_DOMAIN};
  ssl_certificate /etc/letsencrypt/live/${PUBLIC_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${PUBLIC_DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:10m;
  include /etc/nginx/oracle-security-headers.conf;
  add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

  location = /robots.txt { access_log off; default_type text/plain; return 200 "User-agent: *\nDisallow: /\n"; }
  location = /nginx-health { access_log off; default_type text/plain; return 200 "nginx ok\n"; }
  location = /api/users/login {
    limit_req zone=login_zone burst=3 nodelay;
    limit_req_status 429;
    include /etc/nginx/oracle-proxy.conf;
    proxy_pass http://cms:3001;
  }
  location = /api/users/forgot-password {
    limit_req zone=login_zone burst=2 nodelay;
    limit_req_status 429;
    include /etc/nginx/oracle-proxy.conf;
    proxy_pass http://cms:3001;
  }
  location ^~ /api/ {
    limit_req zone=admin_zone burst=20 nodelay;
    limit_req_status 429;
    include /etc/nginx/oracle-proxy.conf;
    proxy_pass http://cms:3001;
  }
  location / { include /etc/nginx/oracle-proxy.conf; proxy_pass http://cms:3001; }
}
