# Modèle OVH pour le déploiement du site en production.
# Le nom .env.ovh.test est conservé pour compatibilité avec les scripts existants.
# Copier sur le VPS en .env.ovh.test, remplacer tous les change-me,
# puis chmod 600 .env.ovh.test. Ne jamais committer le fichier réel.
NODE_ENV=production
COMPOSE_PROJECT_NAME=africa-ingenierie
RELEASE_VERSION=20260907-1
TZ=Africa/Porto-Novo

# Domaine de production uniquement. Ne pas modifier la zone de africaingenierie.com.
PUBLIC_DOMAIN=ingenierieafrica.com
ADMIN_DOMAIN=admin.ingenierieafrica.com
NEXT_PUBLIC_SITE_URL=https://ingenierieafrica.com
PAYLOAD_PUBLIC_SERVER_URL=https://admin.ingenierieafrica.com
CMS_INTERNAL_URL=http://cms:3001

POSTGRES_USER=cms_user
POSTGRES_PASSWORD=change-me-long-postgres-password
POSTGRES_DB=africa_ingenierie
DATABASE_URL=postgres://cms_user:change-me-long-postgres-password@postgres:5432/africa_ingenierie

PAYLOAD_SECRET=change-me-random-payload-secret
PREVIEW_SECRET=change-me-random-preview-secret
REVALIDATION_SECRET=change-me-random-revalidation-secret
REVALIDATION_URL=http://web:3000/api/revalidate
CONTACT_HASH_SECRET=change-me-random-contact-hash-secret
AUDIT_HASH_SECRET=change-me-random-audit-hash-secret
CONTACT_INTERNAL_SECRET=change-me-random-contact-internal-secret
CMS_INTERNAL_READ_SECRET=change-me-random-cms-internal-read-secret

MINIO_ROOT_USER=change-me-minio-admin
MINIO_ROOT_PASSWORD=change-me-long-minio-password
MINIO_ACCESS_KEY=change-me-minio-app
MINIO_SECRET_KEY=change-me-long-minio-app-secret
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_BUCKET=africa-media

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=change-me-smtp-user
SMTP_PASSWORD=change-me-smtp-password
SMTP_FROM_NAME=Africa Ingenierie
SMTP_FROM_ADDRESS=no-reply@ingenierieafrica.com
CONTACT_TO=contact@ingenierieafrica.com

AUTH_COOKIE_DOMAIN=
CONTACT_RETENTION_MONTHS=24
CERTBOT_EMAIL=admin@ingenierieafrica.com
# Première mise en ligne uniquement : permet à Certbot de répondre en HTTP
# avant l'émission du certificat. Repasser à false après certbot certonly.
TLS_BOOTSTRAP=true

BACKUP_ENCRYPTION_KEY=change-me-backup-key-at-least-32-characters
BACKUP_RETENTION_DAYS=30
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
