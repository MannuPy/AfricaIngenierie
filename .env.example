# ════════════════════════════════════════════════════════════════════
#  Africa Ingénierie  -  variables d'environnement LOCALES
#  ------------------------------------------------------------------
#  1. Copier ce fichier :   cp .env.example .env.local
#  2. Remplacer TOUTES les valeurs marquées « change-me » et
#     générer un vrai secret Payload (voir plus bas).
#  3. .env.local est ignoré par Git  -  il ne doit JAMAIS être committé.
#
#  Aucune valeur de ce fichier n'est un secret réel : ce sont des
#  valeurs de développement local, inutilisables en production.
#  En production, les secrets sont injectés par l'environnement du
#  serveur ou un gestionnaire de secrets, jamais par un fichier du dépôt.
# ════════════════════════════════════════════════════════════════════

# ── Général ─────────────────────────────────────────────────────────
NODE_ENV=development
COMPOSE_PROJECT_NAME=africa-ingenierie
TZ=Africa/Porto-Novo

# ── URL publiques (via Nginx, port 8080) ────────────────────────────
# Site public
NEXT_PUBLIC_SITE_URL=http://localhost:8080
# Dashboard Payload  -  servi sur un sous-domaine dédié, comme en production
PAYLOAD_PUBLIC_SERVER_URL=http://admin.localhost:8080
# Appels serveur-à-serveur à l'intérieur du réseau Docker
CMS_INTERNAL_URL=http://cms:3001

# ── PostgreSQL (réseau backend uniquement, jamais public) ───────────
POSTGRES_USER=cms_user
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_DB=africa_ingenierie
DATABASE_URL=postgres://cms_user:change-me-local-db-password@postgres:5432/africa_ingenierie

# ── Payload ─────────────────────────────────────────────────────────
# Générer une valeur aléatoire longue, par exemple :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PAYLOAD_SECRET=change-me-generate-a-long-random-secret

# ── MinIO (réseau backend uniquement, jamais public) ────────────────
MINIO_ROOT_USER=local-access
MINIO_ROOT_PASSWORD=change-me-local-minio-secret
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_BUCKET=africa-media
MINIO_ACCESS_KEY=local-access
MINIO_SECRET_KEY=change-me-local-minio-secret

# ── SMTP de test (Mailpit) ──────────────────────────────────────────
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Africa Ingenierie (local)
SMTP_FROM_ADDRESS=no-reply@local.africa-ingenierie.test
CONTACT_TO=contact@local.africa-ingenierie.test

# ── Comptes de développement local ──────────────────────────────────
# Le script `pnpm --filter @africa-ingenierie/cms bootstrap:users` crée les
# six comptes .test documentés. Il REFUSE de s'exécuter si l'un de ces
# garde-fous n'est pas satisfait, ou si DATABASE_URL vise une base distante.
BOOTSTRAP_USERS_ENABLED=true
BOOTSTRAP_USERS_ENV=local
# Les mots de passe générés sont écrits dans
# apps/cms/.bootstrap-users.local.json (ignoré par Git), jamais affichés.

# ── Cookies de session ──────────────────────────────────────────────
# Laisser vide en local. En production, le domaine du dashboard.
AUTH_COOKIE_DOMAIN=

# ── Conservation des données ────────────────────────────────────────
# Durée de conservation des messages de contact, en mois.
# Valeur proposée, À CONFIRMER par le Client et son conseil juridique
# avant la mise en production (docs/politique-conservation-donnees.md).
CONTACT_RETENTION_MONTHS=24

# ── Prévisualisation avant publication ──────────────────────────────
# Secret partagé entre le dashboard et la route /api/preview du site
# public (implémentée au prompt 07).
PREVIEW_SECRET=change-me-generate-a-preview-secret

# Secret de signature CMS → Next.js pour la revalidation à la publication.
REVALIDATION_SECRET=change-me-generate-a-revalidation-secret
# HMAC des empreintes IP et navigateur des formulaires de contact.
CONTACT_HASH_SECRET=change-me-generate-a-contact-hash-secret
# Secret interne distinct de PAYLOAD_SECRET en production. Il n'est jamais
# envoyé au navigateur et autorise uniquement web -> CMS pour le contact.
CONTACT_INTERNAL_SECRET=change-me-generate-a-contact-internal-secret
CMS_INTERNAL_READ_SECRET=change-me-generate-a-cms-internal-read-secret
REVALIDATION_URL=http://web:3000/api/revalidate

# ── Ports exposés sur l'hôte ────────────────────────────────────────
# Seul Nginx écoute sur toutes les interfaces.
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443
# Les ports ci-dessous sont liés à 127.0.0.1 uniquement (voir
# docker-compose.override.yml) et n'existent qu'en développement.
POSTGRES_DEV_PORT=5432
MINIO_DEV_PORT=9000
MINIO_CONSOLE_DEV_PORT=9001
MAILPIT_UI_DEV_PORT=8025

# ── Limites de ressources des conteneurs ────────────────────────────
LIMIT_WEB_CPUS=1.5
LIMIT_WEB_MEMORY=1536M
LIMIT_CMS_CPUS=1.5
LIMIT_CMS_MEMORY=1536M
LIMIT_POSTGRES_CPUS=1.0
LIMIT_POSTGRES_MEMORY=768M
LIMIT_MINIO_CPUS=0.75
LIMIT_MINIO_MEMORY=512M
LIMIT_NGINX_CPUS=0.5
LIMIT_NGINX_MEMORY=192M
LIMIT_MAILPIT_CPUS=0.25
LIMIT_MAILPIT_MEMORY=192M
